{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource-manifest.schema.json",
  "title": "Map-owned resource manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "profileId", "resources"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "profileId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "resources": {
      "type": "array",
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "ownerProfileId", "rootId", "path", "type", "role", "format"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "ownerProfileId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "rootId": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*:)(?!.*\\\\)(?!.*(?:^|/)(?:\\.|%2[eE])(?:\\.|%2[eE])?(?:/|$))(?!.*%(?:2[fF]|5[cC]|25)).+$"
        },
        "type": { "enum": ["raster", "vector", "document", "table"] },
        "role": { "type": "string", "minLength": 1 },
        "format": { "type": "string", "minLength": 1 },
        "checksum": { "type": ["string", "null"], "pattern": "^[a-fA-F0-9]{64}$" },
        "spatial": { "type": "object" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "raster" } }, "required": ["type"] },
          "then": {
            "required": ["spatial"],
            "properties": {
              "spatial": { "$ref": "#/$defs/rasterSpatial" }
            }
          }
        }
      ]
    },
    "rasterSpatial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crs", "transform", "dimensions", "resolution", "bounds", "nodata"],
      "properties": {
        "crs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition"],
          "properties": {
            "definition": { "type": "string", "minLength": 1 },
            "authority": { "type": ["string", "null"] },
            "parameters": { "type": "object" }
          }
        },
        "transform": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": { "type": "string", "minLength": 1 },
            "parameters": { "type": "object" },
            "values": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "number" }
            }
          },
          "anyOf": [
            { "required": ["parameters"] },
            { "required": ["values"] }
          ]
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height", "bands", "dtype"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 },
            "bands": { "type": "integer", "minimum": 1 },
            "dtype": { "type": "string", "minLength": 1 }
          }
        },
        "resolution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["x", "y", "unit"],
          "properties": {
            "x": { "type": "number", "exclusiveMinimum": 0 },
            "y": { "type": "number", "exclusiveMinimum": 0 },
            "unit": { "type": "string", "minLength": 1 }
          }
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minX", "minY", "maxX", "maxY"],
          "properties": {
            "minX": { "type": "number" },
            "minY": { "type": "number" },
            "maxX": { "type": "number" },
            "maxY": { "type": "number" }
          }
        },
        "nodata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["value", "maskResourceId"],
          "properties": {
            "value": { "type": ["number", "string", "null"] },
            "maskResourceId": { "type": ["string", "null"] }
          }
        }
      }
    }
  }
}
